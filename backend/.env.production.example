# Production variables — set them in the Render dashboard (render.yaml lists
# them). This file is a checklist only: NEVER put real values here or commit
# a filled-in copy. On a self-hosted VM, copy it to backend/.env instead.

ENVIRONMENT=production

# Random, >= 32 chars. Render generates it (render.yaml: generateValue).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
DATABASE_URL=

STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=payment-proofs

# The site's public origin, e.g. https://tgl.skykeen.in (used in reset links).
PUBLIC_ORIGIN=

TRUSTED_PROXY_HOPS=1
SESSION_HOURS=24

# Resend (https://resend.com) — required in production: signup, login and
# reset codes are only ever emailed, never returned by the API.
RESEND_API_KEY=
EMAIL_FROM=TGL <tgl@skykeen.in>
