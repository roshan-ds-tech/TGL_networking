# Copy to backend/.env ON THE VM (never commit the real file).
#
# DATABASE_URL / UPLOAD_DIR / ADMIN_DIST_DIR are deliberately left OUT here —
# the Dockerfile already bakes in the correct in-container paths
# (/app/var/tgl.db, /app/var/uploads, /app/static/admin) that line up with
# the docker-compose bind mount. Setting them here would override those with
# the wrong (dev-style relative) paths from .env.example.

ENVIRONMENT=production

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Your public marketing site's real deployed origin (for the registration
# form's CORS). Update this once tgl-react is deployed.
PUBLIC_ORIGIN=https://tglwebsite.vercel.app

SESSION_HOURS=24

# Resend (https://resend.com) — required in production. Verification email
# cannot send without it, and signup does not return dev_verification_token
# once ENVIRONMENT=production.
RESEND_API_KEY=
EMAIL_FROM=TGL <tgl@skykeen.in>
