# Copy to .env and fill in. NEVER commit the real .env.
ENVIRONMENT=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# SQLite (default, fast, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./var/tgl.db
# Postgres / Supabase — paste the connection string as given; postgres:// and
# ?sslmode=require are handled (see app/database.py):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Payment-proof storage: "local" (UPLOAD_DIR) or "supabase" (private bucket).
STORAGE_BACKEND=local
SUPABASE_URL=
# Server-side secret. Never put it in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=payment-proofs

UPLOAD_DIR=./var/uploads
PUBLIC_ORIGIN=http://localhost:5173
ADMIN_DIST_DIR=./static/admin
# Built public site; served by this app when present (production image).
SITE_DIST_DIR=./static/site
# Reverse proxies in front that append X-Forwarded-For (Render: 1, local: 0).
TRUSTED_PROXY_HOPS=0
SESSION_HOURS=24

# Resend (https://resend.com) — free-tier transactional email for signup
# verification codes. Leave blank in local dev to skip sending (the API then
# returns the code as dev_verification_token / dev_otp and the SPA pre-fills
# it, so signup works without a real inbox). When set, codes are only ever
# emailed — never returned or pre-filled. REQUIRED in production.
RESEND_API_KEY=
EMAIL_FROM=TGL <tgl@skykeen.in>

# --- Phase 0 safety gate (docs/PHASE_0_IMPLEMENTATION_REPORT.md) ---
# Management must confirm in writing that the Connect / Growth / Elite prices and terms
# (Rs 3,000 / 3 months, Rs 5,000 / 6 months, Rs 10,000 / 12 months) are correct
# before any feature may let points reduce an invoice. Only app/pricing_gate.py
# reads this; no discount or redemption exists. Leave it false until that
# confirmation is on file.
SUBSCRIPTION_PRICING_CONFIRMED=false

# --- Subscription payment instructions ---
# The official text telling a member how to pay a subscription invoice (bank / UPI
# details). Leave EMPTY until management supplies it: the app then tells members
# that instructions are pending and shows no payment details. Never put sample or
# placeholder bank details here - whatever is set is shown to members as-is.
# SUBSCRIPTION_PAYMENT_INSTRUCTIONS=

# --- Deal verification thresholds (whole rupees) ---
# AWAITING MANAGEMENT CONFIRMATION - these defaults are engineering assumptions.
# Set DEAL_THRESHOLDS_CONFIRMED=true only once management has approved them.
# DEAL_EVIDENCE_THRESHOLD_INR=100000
# DEAL_ADMIN_APPROVAL_THRESHOLD_INR=500000
# DEAL_QUICK_CLOSE_HOURS=24
DEAL_THRESHOLDS_CONFIRMED=false

# --- Growth Points, Phase 1: SHADOW MODE (docs/PHASE_1_SHADOW_MODE_IMPLEMENTATION_REPORT.md) ---
# Shadow points are recorded and analysed only. They NEVER change an invoice, a payment or a price.
# Set to true on an environment to start recording; set back to false to stop (nothing is lost, nothing is deleted).
GROWTH_POINTS_SHADOW_MODE=false
# MUST stay false. The app refuses to start with true: redemption is not implemented.
GROWTH_POINTS_REDEMPTION_ENABLED=false
# Show members a labelled "shadow preview" of their points (a management decision, off until it is made).
GROWTH_POINTS_MEMBER_PREVIEW=false
# Comma-separated emails of the programme-owner admin account(s): the only admins who may approve a Growth Points pair exception
# (and the owners of the daily reconciliation). Empty = nobody can approve an exception.
PROGRAMME_OWNER_EMAILS=
# --- Growth Points, Phase 2/3: REAL redemption. ALL OF THIS STAYS EMPTY / OFF until management has approved Phase 3. ---
# Recorded external approvals (comma-separated codes; an attestation, never verified): MANAGEMENT_MODEL, ACCOUNTING_GST, PRODUCTION_BACKUP, ROLLBACK_TESTED, MEMBER_TERMS, MONITORING_OWNER.
# The app refuses to start with GROWTH_POINTS_REDEMPTION_ENABLED=true unless ALL of them are listed.
GROWTH_POINTS_APPROVALS=
# internal (programme owners only) | cohort (+ GROWTH_POINTS_ROLLOUT_EMAILS) | all
GROWTH_POINTS_ROLLOUT_STAGE=internal
GROWTH_POINTS_ROLLOUT_EMAILS=
# THE ELIGIBILITY CUTOFF. Shadow-period points NEVER carry over (final decision). Only points earned AT OR AFTER this instant can ever be redeemed (inclusive, compared in UTC).
# FORMAT: ISO-8601 datetime WITH an explicit offset, e.g. 2027-01-01T00:00:00+05:30 (a bare date or a time without an offset stops the app starting).
# EMPTY = nothing is redeemable. It only counts when it equals the cutoff recorded once, immutably, in the database by the programme owner
# (POST /api/admin/growth-points/redemption/epoch) AFTER management approval. NEVER set it without an officially approved cutoff.
GROWTH_POINTS_REDEEMABLE_FROM=
# DEVELOPMENT / TEST ONLY (refused in production): same format; lets @demo.example.com demo members run a rolled-back redemption SIMULATION. Leave empty everywhere real.
GROWTH_POINTS_DEMO_CUTOFF=
